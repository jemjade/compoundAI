{
  "schema_version": 1,
  "provider": "ollama_generate",
  "model": "llama3:latest",
  "base_url": "http://127.0.0.1:11434",
  "api_key_env": null,
  "timeout_seconds": 180,
  "max_retries": 0,
  "synthesis_mode": "passthrough",
  "synthesis_batch_chars": 90000,
  "chunk_chars": 3000,
  "chunk_overlap_chars": 300,
  "retrieval_top_k": 4,
  "synthesis_max_output_tokens": 12000,
  "qa_max_output_tokens": 700,
  "qa_output_contract": "quantitative_v2",
  "reasoning_effort": null,
  "verbosity": null,
  "temperature": 0,
  "top_p": null,
  "max_calls_per_pipeline": 8,
  "ollama_num_ctx": 8192,
  "ollama_keep_alive": "10m"
}
