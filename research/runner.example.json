{
  "schema_version": 1,
  "provider": "openai_responses",
  "model": "gpt-5.6-terra",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_seconds": 120,
  "max_retries": 0,
  "synthesis_batch_chars": 90000,
  "chunk_chars": 5000,
  "chunk_overlap_chars": 400,
  "retrieval_top_k": 6,
  "synthesis_max_output_tokens": 12000,
  "qa_max_output_tokens": 1200,
  "reasoning_effort": "none",
  "verbosity": "low",
  "temperature": null,
  "top_p": null,
  "max_calls_per_pipeline": 64
}
