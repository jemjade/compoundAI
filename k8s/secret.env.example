# 이 파일을 secret.env로 복사한 뒤 실제 값을 입력한다.
# secret.env는 .gitignore에 포함되어 있으므로 Commit하지 않는다.
# 개발기 시연 배포는 ConfigMap의 emptyDir SQLite를 사용하므로 DB Secret이 없다.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SYNAP_API_KEY=
# 파수 로그인 계정. FASOO_API_KEY를 비워 두면 이 계정으로 자동 로그인한다.
FASOO_USERNAME=
FASOO_PASSWORD=
# 선택 호환값: 수동 발급한 정적 Access Token을 사용할 때만 입력한다.
FASOO_API_KEY=
