# .env로 복사한 뒤 환경에 맞게 기본값과 Secret을 변경한다.
APP_ENV=local
APP_NAME=ParseLab
DATABASE_URL=postgresql+asyncpg://parselab:parselab@localhost:5432/parselab
JWT_SECRET=change-this-before-sharing-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
DATA_ROOT=./data
MAX_UPLOAD_SIZE_MB=100
MAX_CONCURRENT_RUNS=2
CORS_ORIGINS=http://localhost:5173
COMMAND_ALLOWED_EXECUTABLES=docling,uv,docker
DOCLING_BASE_URL=
DOCLING_API_KEY=parselab-local-docling
DOCLING_DEVICE=cpu
DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu:latest
DOCLING_PORT=15001
# Native macOS MinerU example: http://host.docker.internal:18001
# Kubernetes/Docker service example: http://mineru:8000
MINERU_BASE_URL=
SYNAP_API_KEY=
INSTALL_PADDLEOCR=false
PADDLEOCR_ENABLED=false
PADDLEOCR_DEVICE=cpu
PADDLEOCR_MAX_CONCURRENCY=1
PADDLEOCR_MODEL_CACHE_DIR=
PADDLEOCR_USE_DOC_ORIENTATION=true
PADDLEOCR_USE_DOC_UNWARPING=true
PADDLEOCR_USE_TEXTLINE_ORIENTATION=true
PADDLEOCR_USE_TABLE_RECOGNITION=true
PADDLEOCR_USE_FORMULA_RECOGNITION=false
PADDLEOCR_USE_CHART_RECOGNITION=false
PADDLEOCR_USE_SEAL_RECOGNITION=false
FASOO_ENABLED=false
FASOO_BASE_URL=
FASOO_API_KEY=
FASOO_TIMEOUT_SECONDS=300
FASOO_ARTIFACT_WAIT_SECONDS=5
FASOO_DETECT_PATH=/piiapi/detect/system/path
FASOO_CONFIGURATION_PATH=/piiapi/configuration
NAS_MOUNT_PATH=/app/data/dwp_comp
FASOO_NAS_PATH=/dwp_comp
FASOO_WORK_SUBDIR=parselab
FASOO_CA_BUNDLE=
FASOO_PATTERNS=
FASOO_LABELS=
FASOO_RULE_JSON=
FASOO_MASKING_CHAR=*
FASOO_RULE_VERSION=1.3
FASOO_SYSTEM_CODE=FASOO
FASOO_SYSTEM_NAME=파수
FASOO_INPUT_TYPE=TEXT
AUTO_CREATE_TABLES=true
VITE_API_URL=http://localhost:8000/api/v1
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
