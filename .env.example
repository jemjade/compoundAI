# .env로 복사한 뒤 환경에 맞게 기본값과 Secret을 변경한다.
APP_ENV=local
APP_NAME=ParseLab
DATABASE_URL=postgresql+asyncpg://parselab:parselab@localhost:5432/parselab
JWT_SECRET=change-this-before-sharing-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
DATA_ROOT=./data
MAX_UPLOAD_SIZE_MB=100
MAX_CONCURRENT_RUNS=2
CORS_ORIGINS=http://localhost:5173
COMMAND_ALLOWED_EXECUTABLES=docling,uv,docker
SYNAP_API_KEY=
FASOO_ENABLED=false
FASOO_BASE_URL=
FASOO_API_KEY=
FASOO_TIMEOUT_SECONDS=300
FASOO_INPUT_TYPE=TEXT
AUTO_CREATE_TABLES=true
VITE_API_URL=http://localhost:8000/api/v1
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
